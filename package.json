{
  "name": "paisa-purpose",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "worker": "tsx --conditions=react-server --tsconfig tsconfig.json src/worker/index.ts",
    "worker:once": "tsx --conditions=react-server --tsconfig tsconfig.json src/worker/index.ts --run-now",
    "e2e": "node scripts/e2e-smoke.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
