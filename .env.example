# ---------------------------------------------------------------
# Barely Balanced — environment template. Copy to .env and fill in.
# Never commit .env. All values below are placeholders.
# ---------------------------------------------------------------

# Branding (rename the app without code changes)
# NEXT_PUBLIC_APP_NAME="Barely Balanced"
# NEXT_PUBLIC_APP_TAGLINE="Understand your money, make informed decisions, and follow through every day."

# App URL (used for auth callbacks and OAuth redirect URIs)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://paisa:paisa_dev@localhost:5432/paisa_dev

# Auth: 32+ random bytes. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# AES-256-GCM key for integration tokens (32 bytes, base64). Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Demo mode: "true" shows the "Explore with sample data" entry point. Set "false" in production.
DEMO_MODE_ENABLED=true

# --- Google (optional). Sign-in uses openid/email/profile only. ---
# Calendar scopes are requested separately and incrementally from Settings > Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- News provider (optional). Comma-separated RSS/Atom feed URLs you are permitted to use. ---
# Leave empty to show clearly labelled demonstration stories only.
NEWS_RSS_FEEDS=

# --- AI explanations (optional). Off unless a key is set AND the user opts in. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Web push (optional). Generate: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
